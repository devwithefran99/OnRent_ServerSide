# Copy this file to .env and fill in real values.

PORT=5000

# Same MongoDB Atlas connection string as the Next.js app.
# Both apps must use the "OnRent" database.
MONGODB_URI=

# Next.js app URL (used by CORS). Separate multiple origins with commas.
CLIENT_ORIGIN=http://localhost:3000

# Next.js app URL (used to fetch the JWKS public keys for JWT verification).
BETTER_AUTH_URL=http://localhost:3000
